-        """Resolve cu_seqlens for packed sequence all-to-all, handling alignment padding."""
-        if cu_seqlens_padded is not None:
-            cu_seqlens = cu_seqlens_padded
+        """Resolve cu_seqlens for packed sequence kernels, handling alignment padding.
+
+        Prefer logical (actual) boundaries when present so EOS pad-tails and
+        alignment pads are not run through FLA/causal_conv1d. Callers that need
+        ``cu[-1] == total_seq_len`` for TE should use padded separately.
+        """
+
+        def _strip(cu: torch.Tensor) -> torch.Tensor:
+            if not isinstance(cu, torch.Tensor) or cu.numel() < 2:
+                return cu
+            end = int(cu.numel())
+            while end > 1 and int(cu[end - 1].item()) == int(cu[end - 2].item()):
+                end -= 1
+            return cu[:end].contiguous() if end != int(cu.numel()) else cu
+
+        actual = _strip(cu_seqlens_actual) if cu_seqlens_actual is not None else None
+        padded = _strip(cu_seqlens_padded) if cu_seqlens_padded is not None else None
+
+        # CP>1 needs physical alignment lengths; CP=1 prefers logical content.
+        if cp_size > 1 and padded is not None:
+            cu_seqlens = padded
+        elif actual is not None:
+            cu_seqlens = actual
         else:
-            cu_seqlens = cu_seqlens_actual
+            cu_seqlens = padded
 
-        total_cu = cu_seqlens[-1].cpu().item()
-        if total_cu != total_seq_len:
+        total_cu = int(cu_seqlens[-1].cpu().item())
+        if total_cu > total_seq_len:
+            raise ValueError(
+                f"GDN: {name}[-1]={total_cu} exceeds "
+                f"total_sequence_length={total_seq_len}. "
+                f"({cu_seqlens_padded=}, {cu_seqlens_actual=})."
+            )
+        # Allow logical cu shorter than the tensor (EOS pad-tail retained for TE).
+        if total_cu != total_seq_len and padded is not None:
+            pad_total = int(padded[-1].cpu().item())
+            if pad_total != total_seq_len:
+                raise ValueError(
+                    f"GDN: padded {name}[-1]={pad_total} does not match "
+                    f"total_sequence_length={total_seq_len}."
+                )
+        elif total_cu != total_seq_len:
             raise ValueError(
                 f"GDN: {name}[-1]={total_cu} does not match "
                 f"total_sequence_length={total_seq_len}. "
@@ -468,6 +502,11 @@ class _GDNBase(MegatronModule):
                 f"All per-sequence lengths in cu_seqlens must be divisible by cp_size={cp_size}, "
                 f"but got lengths: {seq_lengths.tolist()}"
             )
+        if (seq_lengths <= 0).any():
+            raise ValueError(
+                f"GDN: {name} contains non-positive sequence lengths after trim: "
+                f"{seq_lengths.tolist()}"
+            )
 
         return cu_seqlens
 
