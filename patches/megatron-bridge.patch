+def _skip_lora_on_excluded_prefixes(lora: LoRA | VLMLoRA, prefixes: tuple[str, ...]) -> LoRA | VLMLoRA:
+    """Do not wrap modules matching exclude prefixes (same idea as training SkipMtpLoRA).
+
+    ``--exclude-adapter-base-prefix`` is only applied at HF save time. Dist checkpoint
+    load still requests every adapter the in-memory model has; if training skipped MTP
+    LoRA, those keys are absent and load raises KeyError.
+    """
+    if not prefixes:
+        return lora
+    orig_transform = lora.transform
+
+    def transform(module, name=None, prefix=None):
+        parts = [p for p in (prefix or "").split(".") if p]
+        if name:
+            parts.append(name)
+        path = ".".join(parts)
+        if any(excl in path for excl in prefixes):
+            return module
+        return orig_transform(module, name=name, prefix=prefix)
+
+    lora.transform = transform  # type: ignore[method-assign]
+    return lora
+
+
+def _drop_excluded_adapter_keys(state_dict: Mapping[str, object], prefixes: tuple[str, ...]) -> dict[str, object]:
+    """Drop adapter keys matching exclude prefixes before dist-checkpoint load."""
+    if not prefixes:
+        return dict(state_dict)
+    out: dict[str, object] = {}
+    for section, value in state_dict.items():
+        is_model = section == "model" or (section.startswith("model") and section[5:].isdigit())
+        if is_model and isinstance(value, dict):
+            out[section] = {k: v for k, v in value.items() if not any(excl in k for excl in prefixes)}
+        else:
+            out[section] = value
+    return out
+
